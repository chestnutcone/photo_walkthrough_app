@{
    var nonce = Context.Items[AdminHeadersMiddleware.NonceKey] as string ?? "";
    var signedIn = User.Identity?.IsAuthenticated == true && User.HasClaim(AdminAuth.AdminClaim, "1");
}
<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<meta name="robots" content="noindex, nofollow">
@await RenderSectionAsync("Head", required: false)
<title>@ViewData["Title"] - Admin</title>
<style nonce="@nonce">
:root{--paper:#f4f1ea;--card:#fffdf8;--ink:#1c1a17;--muted:#6a645a;--line:#ddd6c8;--accent:#a8391f;--ok:#2d6a3e;--warn:#9a6a00}
@@media (prefers-color-scheme:dark){:root{--paper:#16140f;--card:#1f1c16;--ink:#efe9dc;--muted:#a1988a;--line:#35302a;--accent:#e58a6c;--ok:#7bc08d;--warn:#e0b24a}}
*{box-sizing:border-box}
body{margin:0;background:var(--paper);color:var(--ink);font:15px/1.5 system-ui,sans-serif}
header.bar{display:flex;gap:20px;align-items:center;padding:12px 24px;border-bottom:2px solid var(--ink);background:var(--card)}
header.bar .brand{font:700 13px/1 system-ui,sans-serif;letter-spacing:.16em;text-transform:uppercase}
header.bar nav{display:flex;gap:16px;flex:1}
a{color:var(--accent)}
main{max-width:1080px;margin:0 auto;padding:24px}
h1{font:700 28px/1.1 Georgia,serif;margin:0 0 16px}
h2{font:700 18px/1.2 Georgia,serif;margin:28px 0 8px}
.counts{display:flex;flex-wrap:wrap;gap:12px;margin:0 0 20px;padding:0;list-style:none}
.counts li{background:var(--card);border:1px solid var(--line);border-left:4px solid var(--ink);padding:10px 16px;min-width:120px}
.counts b{display:block;font:700 26px/1 Georgia,serif}
.counts span{color:var(--muted);font-size:12px;text-transform:uppercase;letter-spacing:.08em}
.counts li.hot{border-left-color:var(--accent)}
table{width:100%;border-collapse:collapse;background:var(--card);border:1px solid var(--line)}
th,td{text-align:left;padding:8px 10px;border-bottom:1px solid var(--line);vertical-align:top}
th{font-size:12px;text-transform:uppercase;letter-spacing:.08em;color:var(--muted)}
.thumb{display:block;width:72px;height:auto;max-height:96px;object-fit:cover;border:1px solid var(--line)}
.detail-img{display:block;max-width:100%;max-height:420px;height:auto;border:1px solid var(--line)}
.tag{display:inline-block;padding:1px 8px;border:1px solid var(--line);font-size:12px}
.tag.pending{border-color:var(--warn);color:var(--warn)}
.tag.actioned{border-color:var(--ok);color:var(--ok)}
.flash{padding:10px 14px;margin:0 0 16px;border:1px solid var(--line);border-left:4px solid var(--ok);background:var(--card)}
.flash.err{border-left-color:var(--accent)}
form.inline{display:flex;gap:6px;margin:0 0 6px;flex-wrap:wrap}
form.stack{display:flex;flex-direction:column;gap:8px;max-width:520px}
fieldset{border:1px solid var(--line);background:var(--card);margin:0 0 14px;padding:12px 16px}
legend{font-weight:700;padding:0 6px}
input[type=text],input[type=email],input[type=search],select,textarea{font:inherit;color:inherit;background:var(--paper);border:1px solid var(--ink);padding:6px 8px}
button{font:600 14px/1 system-ui,sans-serif;color:var(--paper);background:var(--ink);border:0;padding:8px 14px;cursor:pointer}
button:hover,button:focus-visible{background:var(--accent);outline:2px solid var(--accent);outline-offset:2px}
button.danger{background:var(--accent)}
button.link{background:none;color:var(--accent);padding:0;text-decoration:underline}
.filters{display:flex;gap:10px;align-items:end;flex-wrap:wrap;margin:0 0 16px}
.filters label{display:flex;flex-direction:column;font-size:12px;color:var(--muted);gap:2px}
.text{white-space:pre-wrap;overflow-wrap:anywhere;background:var(--card);border:1px solid var(--line);padding:10px 14px;margin:0 0 10px}
.muted{color:var(--muted)}
dl.facts{display:grid;grid-template-columns:max-content 1fr;gap:4px 16px;margin:0 0 12px}
dl.facts dt{color:var(--muted)}
dl.facts dd{margin:0;overflow-wrap:anywhere}
</style>
</head>
<body>
@if (signedIn)
{
    <header class="bar">
        <span class="brand">Admin</span>
        <nav>
            <a href="/admin">Queue</a>
            <a href="/admin/users">Users</a>
            <a href="/admin/evidence">Evidence</a>
            <a href="/admin/audit">Audit log</a>
        </nav>
        <form method="post" asp-page="/Logout"><button class="link" type="submit">Sign out</button></form>
    </header>
}
<main>
@RenderBody()
</main>
</body>
</html>
